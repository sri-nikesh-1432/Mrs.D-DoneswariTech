# Doneswari AI Telecaller Backend Environment Variables

# LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=

# ElevenLabs Voice
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5

# Database
DATABASE_URL=sqlite+aiosqlite:///./doneswari.db

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5176,http://localhost:5173

# File Limits (20MB)
MAX_UPLOAD_SIZE=20971520
