# ─────────────────────────────────────────────────────────────────
#  Mrs. D — AI Admission Campaign Platform
#  Environment Configuration
#  Copy this file to .env and fill in your values.
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# ── Gemini API ──────────────────────────────────────────────────────
# Get your API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Gemini Model ───────────────────────────────────────────────────
# Available models: gemini-2.5-flash, gemini-2.5-pro, etc.
GEMINI_MODEL=gemini-2.5-flash

# ── RAG Configuration ───────────────────────────────────────────────
# Embedding model for knowledge base
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunk size for document processing (characters)
CHUNK_SIZE=800

# Chunk overlap (characters)
CHUNK_OVERLAP=150

# Number of relevant chunks to retrieve
TOP_K_RESULTS=5

# ── Text-to-Speech ────────────────────────────────────────────────
# Edge-TTS voice (female voice recommended)
TTS_VOICE=en-US-AriaNeural

# TTS speed: +50% = 1.5x faster, 0% = normal, -20% = slower
TTS_RATE=+0%

# TTS volume: +0% = normal
TTS_VOLUME=+0%

# ── Campaign Configuration ─────────────────────────────────────────
# Maximum concurrent calls
MAX_CONCURRENT_CALLS=1

# Number of retry attempts for failed calls
CALL_RETRY_ATTEMPTS=3

# Call timeout in seconds
CALL_TIMEOUT_SECONDS=300

# ── Server ────────────────────────────────────────────────────────
HOST=localhost
PORT=8000

# ── Database ──────────────────────────────────────────────────────
# SQLite for development, PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./mrsd_campaign.db

# ── Security ──────────────────────────────────────────────────────
# Secret key for session management
SECRET_KEY=your-secret-key-change-in-production

# Debug mode (set to False in production)
DEBUG=False

# ── File Upload ───────────────────────────────────────────────────
# Maximum upload size in bytes (50MB default)
MAX_UPLOAD_SIZE=52428800

# ── Logging ───────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Twilio Configuration ───────────────────────────────────────────
# Get your credentials at: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# ── Voice Configuration ────────────────────────────────────────────
# For Indian female voice, use Edge-TTS with these voices:
# en-IN-NeerjaNeural (Indian English female)
# en-IN-HeeraNeural (Indian English female)
# hi-IN-SwaraNeural (Hindi female)
TTS_VOICE=en-IN-NeerjaNeural
