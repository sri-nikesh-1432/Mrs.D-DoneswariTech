# ─────────────────────────────────────────────────────────────────────
# AI Telecaller SaaS — Backend Environment Configuration (spec §65)
# Copy to .env and fill in real values. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────
# SQLite (development default) or PostgreSQL for production:
#   postgresql+asyncpg://user:password@host:5432/telecaller
DATABASE_URL=sqlite+aiosqlite:///./mrsd_campaign.db

# ── LLM (Groq) ───────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Tried in order when the primary model is rate-limited (429)
GROQ_FALLBACK_MODELS=["openai/gpt-oss-120b"]

# ── RAG / Embeddings ─────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5

# ── Telephony (Twilio) — REQUIRED for real phone calls (spec §31-§33) ─
# Without these, call endpoints return 503 with a clear error — the
# platform never simulates calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public HTTPS origin that Twilio's servers can reach for TwiML + status
# webhooks (e.g. https://abc123.ngrok-free.app in dev). MUST be set for
# real calls; media streams use wss:// under the same origin.
PUBLIC_BASE_URL=

# ── Voice / TTS ──────────────────────────────────────────────────────
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=+10%
TTS_PITCH=+1Hz
TTS_VOLUME=+2%
# Expressive prosody engine (1=on, 0=plain)
TTS_EXPRESSIVE=1

# ── ElevenLabs TTS (premium voice engine) ─────────────────────────────
# When ELEVENLABS_API_KEY is set, the voice agent uses ElevenLabs instead
# of Edge TTS. Get a key at https://elevenlabs.io (API keys → Create).
ELEVENLABS_API_KEY=
# Fall back to a warm, natural voice if you don't have a specific voice:
#   https://elevenlabs.io/voices → open a voice → copy the ID from the URL
ELEVENLABS_VOICE_ID=0U7pUcfIxJzwwTseQz75
# Fallback premade voice used when the chosen voice is not permitted for the
# account's plan. Library voices require a paid plan (a Free account gets
# HTTP 402 "paid_plan_required" via the API); premade voices always work.
# Bella — Professional, Bright, Warm (female).
ELEVENLABS_FALLBACK_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
# Last resort: fall back to Edge TTS if ElevenLabs returns no audio (1/0).
ELEVENLABS_ALLOW_EDGE_FALLBACK=1
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ── Server ───────────────────────────────────────────────────────────
HOST=localhost
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
# CORS: the exact origin(s) of the deployed frontend. The browser calls this
# backend cross-origin from Netlify, so the Netlify site MUST be listed here.
# Keep every deployed site origin (the browser sends the bare origin, no path).
ALLOWED_ORIGINS=["http://localhost:5176","https://dtechp1.netlify.app","https://dllp.netlify.app","https://dllp.netlify.com"]

# ── Security ─────────────────────────────────────────────────────────
# CHANGE THIS in production — used for JWT signing
SECRET_KEY=change-me-to-a-long-random-string

# ── Calling campaign ─────────────────────────────────────────────────
MAX_CONCURRENT_CALLS=1
CALL_RETRY_ATTEMPTS=3
CALL_TIMEOUT_SECONDS=300
