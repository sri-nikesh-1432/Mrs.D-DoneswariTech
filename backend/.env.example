# ─────────────────────────────────────────────────────────────────
#  Doneswari AI Telecaller — Environment Configuration
#  Copy this file to .env and fill in your values.
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# ── Groq API ──────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Groq Models ───────────────────────────────────────────────────
# Speech-to-Text model (Whisper)
GROQ_STT_MODEL=whisper-large-v3-turbo

# LLM model for chat completions
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ── Text-to-Speech ────────────────────────────────────────────────
# Default Edge-TTS voice (used as fallback)
TTS_VOICE=te-IN-ShrutiNeural

# TTS speed: +50% = 1.5x faster, 0% = normal, -20% = slower
TTS_RATE=+50%

# ── Server ────────────────────────────────────────────────────────
HOST=localhost
PORT=8000

# ── Frontend ──────────────────────────────────────────────────────
# Vite dev server port — must match vite.config.js
FRONTEND_PORT=5175

# ── Session Management ────────────────────────────────────────────
# Minutes before an idle session is purged
SESSION_TIMEOUT_MINUTES=30

# Maximum conversation turns kept in memory per session
MAX_HISTORY_TURNS=20

# ── Audio Cleanup ─────────────────────────────────────────────────
# Minutes before temporary TTS audio files are deleted
AUDIO_CLEANUP_MINUTES=10

# ── Logging ───────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
